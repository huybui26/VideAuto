{
  "name": "videauto",
  "version": "2.0.0",
  "description": "VideAuto — generate Vietnamese 9:16 short videos from URL or text with HyperFrames templates and OmniVoice TTS",
  "main": "src/cli.ts",
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "pipeline": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "sfx:download": "tsx scripts/download-sfx.ts",
    "sfx:filter": "tsx scripts/filter-sfx.ts",
    "bot": "tsx src/bot-entry.ts",
    "bot:dev": "tsx watch src/bot-entry.ts"
  },
  "keywords": [
    "video",
    "tts",
    "news",
    "vietnamese",
    "tiktok",
    "shorts",
    "hyperframes",
    "claude-code",
    "omnivoice"
  ],
  "author": "VideAuto",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@grammyjs/runner": "^2.0.3",
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "p-limit": "^7.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "nock": "^14.0.13",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
